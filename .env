# Config de docker-compose. Sin secretos: las credenciales las genera el
# emulador en cada arranque, en ~/.aws/emulator/<puerto>/.

# aarch64 (Apple Silicon) o x86_64 (Intel/AMD).
EMULATOR_ARCH=aarch64

# Canal de descarga del paquete. Ver README.md para fijar una versión.
EMULATOR_CHANNEL=LTS/latest

# Cambiá el tag para pinnear una build concreta, ej. aws-emulator:1.0.471.1
EMULATOR_IMAGE=aws-emulator:local

EMULATOR_PORT=9297
EMULATOR_MEMORY=2g
